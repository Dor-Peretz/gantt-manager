# Atlassian Cloud site (no trailing slash)
JIRA_BASE_URL=https://sunbit.atlassian.net

# Your Atlassian account email + API token
# Create a token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=dor.peretz@sunbit.com
JIRA_API_TOKEN=

# Default JQL used by Pull (editable in the toolbar)
# Tip: load several epics with: parent in (SBT-61018, SBT-OTHER, ...)
JIRA_JQL=project = SBT AND parent = SBT-61018 ORDER BY rank ASC

# Local server port
PORT=8787
