# Atlassian Cloud site (no trailing slash)
JIRA_BASE_URL=https://your-site.atlassian.net

# Your Atlassian account email + API token
# Create a token at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Default JQL used by Pull (editable in the toolbar)
# Tip: load several epics with: parent in (PROJ-100, PROJ-OTHER, ...)
JIRA_JQL=project = PROJ AND parent = PROJ-100 ORDER BY rank ASC

# Local server port
PORT=8787
